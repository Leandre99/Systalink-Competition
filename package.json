{
  "name": "koradevs-codeflash",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -c \"emerald.bold,cyan.bold\" -n \"SERVER,VITE\" \"tsx server/index.ts\" \"vite\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "seed": "tsx server/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsx scripts/lint-check.ts",
    "test": "vitest run",
    "audit:licenses": "tsx scripts/audit-licenses.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.28.9",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "framer-motion": "^11.0.24",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.359.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vite": "^5.1.6",
    "vitest": "^1.4.0"
  }
}
