{
  "name": "sos-dev-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "SOS Dev : quand l'IA ne suffit plus, un développeur te rejoint depuis ton terminal.",
  "type": "module",
  "workspaces": [
    "shared",
    "cli",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b cli server",
    "typecheck": "tsc -b cli server && tsc -p tsconfig.json",
    "test": "vitest run",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "sos": "node cli/dist/index.js",
    "server": "node --env-file-if-exists=server/.env server/dist/main.js",
    "db:up": "docker compose up -d --wait postgres"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
