{
  "name": "sos-dev-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "SOS Dev : quand l'IA ne suffit plus, un développeur te rejoint depuis ton terminal.",
  "type": "module",
  "workspaces": [
    "shared",
    "cli",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b cli server && npm run build -w web",
    "typecheck": "tsc -b cli server && tsc -p tsconfig.json && tsc -p web",
    "test": "vitest run",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "sos": "node cli/dist/index.js",
    "server": "node --env-file-if-exists=server/.env server/dist/main.js",
    "db:up": "docker compose up -d --wait postgres",
    "web": "npm run dev -w web"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@types/diff": "^7.0.2",
    "diff": "^9.0.0",
    "yjs": "^13.6.33"
  }
}
